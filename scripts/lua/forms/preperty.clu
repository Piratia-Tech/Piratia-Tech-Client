frmState = UI_CreateForm("frmState", FALSE, 633, 510, 250, 160, TRUE, FALSE)
UI_FormSetHotKey(frmState, ALT_KEY, HOTKEY_A)
UI_ShowForm(frmState, FALSE)
UI_AddFormToTemplete(frmState, 1)
UI_SetIsDrag(frmState, TRUE)

imgBackground = UI_CreateCompent(frmState, IMAGE_TYPE, "imgBackground", 633, 510, 0, 0)
UI_LoadImage(imgBackground, "texture/ui/ui2/preperty.png", NORMAL, 633, 510, 0, 0)

-- Close Button
btnClose = UI_CreateCompent( frmState, BUTTON_TYPE, "btnClose", 28, 28, 600, 3 )
UI_LoadButtonImage( btnClose, "texture/ui/ui2/buttons.png", 25, 26, 381, 3, TRUE )
UI_SetButtonModalResult( btnClose, BUTTON_CLOSE )

labTitle = UI_CreateCompent(frmState, LABELEX_TYPE, "labTitle", 400, 150, (0 + (450 / 2) - math.ceil((string.len('Character Information') * 6) / 2)), 5)
UI_SetCaption(labTitle, "")
UI_SetTextColor(labTitle, COLOR_BLACK)
UI_SetLabelExFont(labTitle, DEFAULT_FONT, TRUE, COLOR_WHITE)

