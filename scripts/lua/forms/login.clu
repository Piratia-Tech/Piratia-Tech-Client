-- Первый ряд
btnNum = {}
KbRow = {"1","2","3","4","5","6","7","8","9","0"}
for i=1,10,1 do
	btnNum[i] = UI_CreateCompent( frmKeyboard, BUTTON_TYPE, "btnNum" .. KbRow[i], 25, 19, 10 + 28 * (i - 1), 46 )
	UI_LoadButtonImage( btnNum[i], "texture/ui/ui2/keyboard.png", 25, 19, 329, 5 + 19 * (i - 1), true )
end

-- Второй ряд
btnLetter = {}
KbRow = {"Q","W","E","R","T","Y","U","I","O","P"}
for i=1,10,1 do
	btnLetter[i] = UI_CreateCompent( frmKeyboard, BUTTON_TYPE, "btnLetter" .. KbRow[i], 25, 19, 10 + 28 * (i - 1), 70 )
	UI_LoadButtonImage( btnLetter[i], "texture/ui/ui2/keyboard.png", 25, 19, 0, 214 + 19 * (i - 1), true )
end

-- Третий ряд
btnLetter = {}
KbRow = {"A","S","D","F","G","H","J","K","L"}
for i=1,9,1 do
	btnLetter[i] = UI_CreateCompent( frmKeyboard, BUTTON_TYPE, "btnLetter" .. KbRow[i], 25, 19, 24 + 28 * (i - 1), 94 )
	UI_LoadButtonImage( btnLetter[i], "texture/ui/ui2/keyboard.png", 25, 19, 102, 214 + 19 * (i - 1), true )
end

-- Четвертый ряд
btnLetter = {}
KbRow = {"Z","X","C","V","B","N","M"}
for i=1,7,1 do
	btnLetter[i] = UI_CreateCompent( frmKeyboard, BUTTON_TYPE, "btnLetter" .. KbRow[i], 25, 19, 52 + 28 * (i - 1), 118)
	UI_LoadButtonImage( btnLetter[i], "texture/ui/ui2/keyboard.png", 25, 19, 204, 214 + 19 * (i - 1), true )
end

