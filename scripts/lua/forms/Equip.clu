--			daily	Reward test 
--------------------------------------------

function addReward(x,y,name,form,skillid)

	_G[name] = UI_CreateCompent (form, COMMAND_ONE_TYPE, name,32, 32, x, y)

	if skillid then

		--UI_AddCompent(skillid, _G[name])

	end

end
function addRewardsToServer(X, Y, Xoff, Yoff, form, skillid)

	for i = 1,31,1 do

		local buf = "serverday"..i

		addReward( X+ ( ((i-1) - math.floor((i-1)/7)*7) * Xoff) , Y + (math.floor((i-1)/7) * Yoff), buf, form, skillid)

	end

end


function addRewardImages(x,y,name,form,skillid)

	_G["imgClaimed"..name] = UI_CreateCompent(form, IMAGE_TYPE, "imgClaimed"..name, 52,52, x, y)

	UI_LoadImage( _G["imgClaimed"..name], "texture/ui/custom/dailyReward2.png", NORMAL, 52,52, 445, 215)

	_G["imgBlocked"..name] = UI_CreateCompent(form, IMAGE_TYPE, "imgBlocked"..name, 52,52, x,y)

	UI_LoadImage( _G["imgBlocked"..name], "texture/ui/custom/dailyReward2.png", NORMAL, 52,52, 445, 272)

	_G["imgLocked"..name] = UI_CreateCompent(form, IMAGE_TYPE, "imgLocked"..name, 52,52, x,y)

	UI_LoadImage( _G["imgLocked"..name], "texture/ui/custom/dailyReward2.png", NORMAL, 52,52, 445, 329)

end


function addImagesToServer(X, Y, Xoff, Yoff, form, skillid)

	for i = 1,31,1 do

		local buf = "serverday"..i

		addRewardImages( X+ ( ((i-1) - math.floor((i-1)/7)*7) * Xoff) , Y + (math.floor((i-1)/7) * Yoff), buf, form, skillid)

	end

end


