frmMinimap = UI_CreateForm( "frmMinimap", false, 166, 233, 656, 15, true, false )
UI_ShowForm( frmMinimap, true )
UI_AddFormToTemplete( frmMinimap, FORM_MAIN )
UI_SetFormStyle( frmMinimap, 9 )
UI_FormSetIsEscClose( frmMinimap, false )

-- Изображение формы
imgMinimap = UI_CreateCompent( frmMinimap, IMAGE_TYPE, "imgMinimapT", 166, 233, 0, 0 )
UI_LoadImage( imgMinimap, "texture/ui/ui2/minimap.png", NORMAL, 166, 233, 0, 0 )


-- Сама мини-карта
imgMinimapRect = UI_CreateCompent( frmMinimap, IMAGE_TYPE, "imgMinimapRect", 128, 126, 3, 20 )

-- Название локации
labMapName = UI_CreateCompent( frmMinimap, LABELEX_TYPE, "labMapName", 104, 12, 10, 5 )
UI_SetCaption( labMapName, "" )
UI_SetTextColor( labMapName, COLOR_WHITE )
UI_SetHint( labMapName, "\205\224\231\226\224\237\232\229 \235\238\234\224\246\232\232" )

-- Координаты
n  = 0
while 1 do
	local name = "labMapPos"..n
	labMapPos = UI_CreateCompent( frmMinimap, LABELEX_TYPE, name, 67, 10, 9, 151 )
	UI_SetCaption( labMapPos, "2200, 2200" )
	UI_SetTextColor( labMapPos, COLOR_WHITE )
	UI_SetHint( labMapPos, "\202\238\238\240\228\232\237\224\242\251 \226\224\248\229\227\238 \240\224\241\239\238\235\238\230\229\237\232\255" )
	if n~=0  then UI_SetIsShow( labMapPos, false ) end
	n = n + 1
	if n==10 then break end
end


