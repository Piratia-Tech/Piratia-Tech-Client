function addSystemOption(frm,compName,cap,cap3,cap1,cap2,y)

	labGame = UI_CreateCompent( frm, LABELEX_TYPE, "labGame", 30, 10, 20, y )
	UI_SetCaption( labGame, cap )
	UI_SetTextColor( labGame, COLOR_WHITE )
	
	labGame = UI_CreateCompent( frm, LABELEX_TYPE, "labGame", 30, 10, 150, y )
	UI_SetCaption( labGame, cap3 )
	UI_SetTextColor( labGame, COLOR_WHITE )
--------------------------------------------------------------
	
	labGame = UI_CreateCompent( frm, LABELEX_TYPE, "labGame", 30, 10, 650, y )
	UI_SetCaption( labGame, cap1 )
	UI_SetTextColor( labGame, COLOR_WHITE )
	
	chkHelpmodel1 = UI_CreateCompent( frm, CHECK_TYPE, "chkHelpmodel1", 14, 14, 635, y )
	UI_LoadImage( chkHelpmodel1, "texture/ui/ui2/system.png", UNCHECKED, 14, 14, 202, 264 )--
	UI_LoadImage( chkHelpmodel1, "texture/ui/ui2/system.png", CHECKED, 14, 14, 220, 264 )
	
	labGame = UI_CreateCompent( frm, LABELEX_TYPE, "labGame", 30, 10, 730, y )
	UI_SetCaption( labGame, cap2 )
	UI_SetTextColor( labGame, COLOR_WHITE )
	
	chkHelpmodel2 = UI_CreateCompent( frm, CHECK_TYPE, "chkHelpmodel2", 14, 14, 715, y )
	UI_LoadImage( chkHelpmodel2, "texture/ui/ui2/system.png", UNCHECKED, 14, 14, 202, 264 )--
	UI_LoadImage( chkHelpmodel2, "texture/ui/ui2/system.png", CHECKED, 14, 14, 220, 264 )
	
-----------------------------------------------------------------------	
	
	cbxEffectl = UI_CreateCompent( frm, CHECK_GROUP_TYPE, compName, 0, 0, 0, 0 )
	UI_AddGroupBox( cbxEffectl, chkHelpmodel1 )
	UI_AddGroupBox( cbxEffectl, chkHelpmodel2 )
end

