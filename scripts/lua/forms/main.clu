-- Смайлики
grdFace = UI_CreateCompent( frmMain800, GRID_TYPE, "grdFace", 142, 170, 321, -194 ) 
UI_LoadImage( grdFace,  "texture/ui/ui2/chat.png", NORMAL, 142, 170, 369, 0 )
UI_SetGridUnitSize( grdFace, 16, 16 )
UI_SetIsShow( grdFace, TRUE )
UI_SetMargin( grdFace, 11, 5, 5, 5 )
UI_SetGridSpace( grdFace, 4, 4 )
UI_SetGridIsDragSize( grdFace, FALSE )

n=0
while 1 do
    name = "texture/ui/ui2/face/"..(n+1)..".tga"       
        UI_AddFaceToGrid( grdFace, name, 16, 16, 0, 0, 1, 0 )
    UI_SetTextParse( n , name, 16, 16 , 0 , 0 ,1 )
    n = n + 1        
        if n>=97 then break end
end

UI_GridLoadSelectImage( grdFace, "texture/ui/ui2/buttons.png", 32, 32, 384, 279 )

-- Действия
grdAction = UI_CreateCompent( frmMain800, GRID_TYPE, "grdAction", 142, 170, 338, -194 ) 
UI_LoadImage( grdAction,  "texture/ui/ui2/chat.png", NORMAL, 142, 170, 369, 0 )
UI_SetGridUnitSize( grdAction, 32, 32 )
UI_SetIsShow( grdAction, FALSE )
UI_SetMargin( grdAction, 5, 4, 0, 0 )
UI_SetGridSpace( grdAction, 1, 1 )
UI_SetGridIsDragSize( grdAction, FALSE )

n=2
while 1 do
	name = "texture/ui/ui2/Action/"..(n)..".tga"   	
	UI_AddFaceToGrid( grdAction, name, 32, 32, 0, 0, 1, n )	
	n = n + 1    	
	if n>=10 then break end
end
n=16
while 1 do
	name = "texture/ui/ui2/Action/"..(n)..".tga"   	
	UI_AddFaceToGrid( grdAction, name, 32, 32, 0, 0, 1, n )	
	n = n + 1    	
	if n>=24 then break end
end
UI_GridLoadSelectImage( grdAction, "texture/ui/ui2/buttons.png", 32, 32, 384, 279 )


-- Настроение
