UI_SetGridUnitSize( grdHeart, 32, 32 )
UI_SetIsShow( grdHeart, FALSE )
UI_SetMargin( grdHeart, 5, 4, 0, 0 )
UI_SetGridSpace( grdHeart, 0, 0 )
