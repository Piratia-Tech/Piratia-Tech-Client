UI_SetSize(id, 9, 44)

-- вниз
id = UI_GetScrollObj(scrollid, SCROLL_DOWN)
UI_LoadButtonImage(id, "texture/ui/PublicC.png", 9, 9, 166, 0, true)
UI_SetSize(id, 9, 9)

