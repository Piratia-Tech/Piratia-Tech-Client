n  = 0
while 1 do
	local name = "labBigMapCoord"..n
	labBigMapCoord = UI_CreateCompent( frmBigmap, LABELEX_TYPE, name, 100, 10, 413, 49 )
	UI_SetCaption( labBigMapCoord, "2200, 2200" )
	UI_SetTextColor( labBigMapCoord, COLOR_BLACK )
	UI_SetLabelExFont( labBigMapCoord, DEFAULT_FONT, TRUE, COLOR_WHITE )
	
	if n~=0  then UI_SetIsShow( labBigMapCoord, FALSE ) end
	
	n = n + 1
	if n==10 then break end	
end

