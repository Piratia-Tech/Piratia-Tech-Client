-- Список порталов (со скроллом и клиппингом)
------------------------------------------------
list = UI_CreateListView(frmPortalTime, "list", 680, 140, 8, 35, 5, 1)
UI_SetListRowHeight(list, 16)

UI_ListViewSetTitle(list, 0, 250, "", 0, 0, 0, 0)
UI_ListViewSetTitle(list, 1, 185, "", 0, 0, 0, 0)
UI_ListViewSetTitle(list, 2, 80, "", 0, 0, 0, 0)
UI_ListViewSetTitle(list, 3, 80, "", 0, 0, 0, 0)
UI_ListViewSetTitle(list, 4, 80, "", 0, 0, 0, 0)

-- Включаем прокрутку мышью
UI_SetListIsMouseFollow(list, TRUE)

-- КРИТИЧНО: обрезаем всё, что выходит за рамки списка
-- (если функция существует в твоём клиенте — она решает проблему полностью)
if UI_SetClipChild then
    UI_SetClipChild(list, TRUE)
end

