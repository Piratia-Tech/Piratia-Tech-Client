UI_ShowForm(frmPortalTime, FALSE)
UI_FormSetHotKey(frmPortalTime, ALT_KEY, HOTKEY_T)
UI_AddFormToTemplete(frmPortalTime, FORM_MAIN)
UI_SetIsDrag(frmPortalTime, TRUE)
UI_SetFormStyle(frmPortalTime, 0)

labInfoShow1 = UI_CreateCompent(frmPortalTime, LABELEX_TYPE, "labInfoShow1", 124, 16, 320, 2)
