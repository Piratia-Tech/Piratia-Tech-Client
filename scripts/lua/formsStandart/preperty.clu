frmState = UI_CreateForm("frmState", FALSE, 446, 471, 0, 100, TRUE, FALSE)
UI_FormSetHotKey(frmState, ALT_KEY, HOTKEY_A)
UI_ShowForm(frmState, FALSE)
UI_AddFormToTemplete(frmState, 1)
UI_SetIsDrag(frmState, TRUE)

imgBackground = UI_CreateCompent(frmState, IMAGE_TYPE, "imgBackground", 446, 471, 0, 0)
UI_LoadImage(imgBackground, "texture/ui/custom/CharacterInformation.png", NORMAL, 446, 471, 0, 0)

btnClose = UI_CreateCompent(frmState, BUTTON_TYPE, "btnClose", 14, 14, 430, 5)
UI_LoadButtonImage( btnClose, "texture/ui/PublicC.tga", 14, 14, 116, 175, TRUE )
UI_SetButtonModalResult(btnClose, BUTTON_CLOSE)

