frmRank = UI_CreateForm( "frmRank", false, 699, 382, 0, 150, true, false )
UI_ShowForm( frmRank, false )
UI_AddFormToTemplete( frmRank, FORM_MAIN )
UI_FormSetIsEscClose( frmRank, true )
UI_SetIsDrag( frmRank,true)
UI_SetFormStyle( frmRank,2)

-- Фон формы
imgBackGround = UI_CreateCompent( frmRank, IMAGE_TYPE, "imgBackGround", 699, 505, 0, 0 )
UI_LoadImage( imgBackGround, "texture/ui/Rank.png", NORMAL, 699, 508, 0, 0 )


-- Закрыть
local btnClose = UI_CreateCompent( frmRank, BUTTON_TYPE, "btnClose", 22, 22, 680, 15 )
UI_LoadButtonImage( btnClose, "texture/ui/fairy.png", 24, 26, 0, 445, false )
UI_SetButtonModalResult( btnClose, BUTTON_CLOSE )

lstRankList = UI_CreateListView( frmRank, "lstRankList", 480,420, 217, 55, 10, 10 )
UI_SetListRowHeight( lstRankList, 20 )
UI_SetMargin( lstRankList, 5, 0, 0, 0 )		
UI_FormSetIsEscClose( lstRankList, TRUE )
UI_ListViewSetTitle( lstRankList, 0, 30, "", 0, 0, 0, 0 )
UI_ListViewSetTitle( lstRankList, 1, 180, "", 0, 0, 0, 0 )
UI_ListViewSetTitle( lstRankList, 2, 45, "", 0, 0, 0, 0 )
UI_ListViewSetTitle( lstRankList, 3, 160, "", 0, 0, 0, 0 )
UI_ListViewSetTitle( lstRankList, 4, 0, "", 0, 0, 0, 0 )
UI_SetListIsMouseFollow( lstRankList, TRUE)

--Скролл
local scrollid = UI_GetScroll( lstRankList )
UI_SetSize( scrollid, 17, 1 )

-- Скролл вверх
local id = UI_GetScrollObj( scrollid, SCROLL_UP )
UI_LoadButtonImage( id, "texture/ui/buttons.png", 13, 9, 387, 55, true )
UI_SetSize( id, 13, 9 )

-- Скролл ползунок
id = UI_GetScrollObj( scrollid, SCROLL_SCROLL )
UI_LoadImage( id, "texture/ui/buttons.png", COMPENT_BACK, 13, 8, 387, 84 )
UI_SetSize( id, 13, 8 )

-- Скролл вниз
id = UI_GetScrollObj( scrollid, SCROLL_DOWN )
UI_LoadButtonImage( id, "texture/ui/buttons.png", 13, 9, 387, 69, true )
UI_SetSize( id, 13, 9 )

